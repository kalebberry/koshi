---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import '../../../styles/layout-studies-entry.css';
const studies = [
  { id:'portfolio', number:'01', title:'Editorial portfolio', type:'Asymmetric gallery', description:'Four independent projects share one structural grid. Offsets and proportions create rhythm without changing the columns.' },
  { id:'feature', number:'02', title:'Split feature', type:'Unequal columns', description:'A quiet editorial feature pairs a large visual with compact copy, using an eight/four column split.' },
  { id:'schedule', number:'03', title:'Event schedule', type:'Structured information', description:'A tour-inspired composition pairs a visual panel with an orderly schedule, then stacks naturally at narrow widths.' },
  { id:'triptych', number:'04', title:'Project triptych', type:'Three-image showcase', description:'A project overview with metadata, three distinct image crops, and a deliberately quiet footer.' },
  { id:'essay', number:'05', title:'Editorial essay', type:'Full-bleed story', description:'A magazine-inspired cover, wide landscape artwork, and supporting copy anchored to the grid.' },
  { id:'catalogue', number:'06', title:'Design catalogue', type:'Product index', description:'A visual product index pairs a prominent feature with smaller supporting entries.' },
  { id:'manifesto', number:'07', title:'Studio manifesto', type:'Typography-led composition', description:'Oversized typography, sparse metadata, and a disciplined split layout.' },
];
const snippets = {
portfolio: `<div class="kos-grid study-portfolio" kos-cols="4">
  <article class="study-project">…</article>
  <article class="study-project">…</article>
  <article class="study-project">…</article>
  <article class="study-project">…</article>
</div>`,
feature: `<div class="kos-grid study-feature" kos-cols="12">
  <div kos-col-span="8">Visual</div>
  <article kos-col-span="4">Story</article>
</div>`,
schedule: `<div class="kos-grid study-schedule" kos-cols="12">
  <div kos-col-span="5">Visual</div>
  <div kos-col-span="7">Schedule</div>
</div>`,
triptych: `<div class="kos-grid study-triptych" kos-cols="3">
  <figure>Image 01</figure><figure>Image 02</figure><figure>Image 03</figure>
</div>`,
essay: `<div class="kos-grid study-essay" kos-cols="12">
  <header kos-col-span="12">Headline and metadata</header>
  <figure kos-col-span="12">Cover artwork</figure>
  <footer kos-col-span="12">Editorial note</footer>
</div>`,
catalogue: `<div class="kos-grid study-catalogue" kos-cols="12">
  <article kos-col-span="7">Featured item</article>
  <article kos-col-span="5">Supporting items</article>
</div>`,
manifesto: `<div class="kos-grid study-manifesto" kos-cols="12">
  <div kos-col-span="8">Statement</div>
  <aside kos-col-span="4">Notes</aside>
</div>`
};
---
<SiteLayout title="Layout Studies" description="Explore responsive compositions built with the real Kōshi CSS grid.">
  <div class="studies-shell shell">
    <header class="studies-intro">
      <p class="studies-kicker">KŌSHI / COMPOSITION LAB / 001—007</p>
      <h1>Layouts with <em>intention.</em></h1>
      <p>Seven responsive compositions built with Kōshi's actual grid primitives. The structure belongs to Kōshi; the art direction belongs to each study.</p>
      <a href="/lab/" class="studies-back">← Back to Composition Lab</a>
    </header>
    <nav class="studies-index" aria-label="Jump to a layout study">
      {studies.map(s => <a href={`#${s.id}`}><span>{s.number}</span><strong>{s.title}</strong><span>↘</span></a>)}
    </nav>
    {studies.map(s => <section id={s.id} class="study-section" aria-labelledby={`${s.id}-title`}>
      <div class="study-heading"><div><p class="studies-kicker">{s.number} / {s.type}</p><h2 id={`${s.id}-title`}>{s.title}</h2></div><p>{s.description}</p></div>
      <div class="study-preview-viewport"><div class="study-canvas" data-preview-canvas style="--preview-width: 1100px">
        {s.id === 'portfolio' && <div class="kos-grid study-portfolio" kos-cols="4">
          <article class="study-project"><div class="study-art art-ink"><span>FORM / 01</span><div class="art-circle"></div></div><p>01 / Objects in space</p><h3>Form and silence</h3></article>
          <article class="study-project"><div class="study-art art-arch"><span>STUDY / 02</span><div class="art-archway"></div></div><p>02 / Architecture</p><h3>Between walls</h3></article>
          <article class="study-project"><div class="study-art art-sun"><span>FIELD / 03</span><div class="art-sun-disc"></div></div><p>03 / Art direction</p><h3>Quiet horizon</h3></article>
          <article class="study-project"><div class="study-art art-line"><span>TYPE / 04</span><div class="art-line-mark">永</div></div><p>04 / Identity</p><h3>Traces of time</h3></article>
        </div>}
        {s.id === 'feature' && <div class="kos-grid study-feature" kos-cols="12">
          <div kos-col-span="8" class="feature-visual"><div class="feature-moon"></div><span>STUDY / STILLNESS</span></div>
          <article kos-col-span="4" class="feature-copy"><p class="studies-kicker">02 / JOURNAL</p><h3>Space to<br/>observe.</h3><p>A composition is not only what you place. It is also what you choose to leave open.</p><span class="feature-rule">DESIGN NOTES — 2026</span></article>
        </div>}
        {s.id === 'schedule' && <div class="kos-grid study-schedule" kos-cols="12">
          <div kos-col-span="5" class="schedule-visual"><span>JAPAN / 2026</span><div class="schedule-orbit"></div><strong lang="ja">旅</strong><small>AN EXERCISE IN STRUCTURE</small></div>
          <div kos-col-span="7" class="schedule-content"><div class="schedule-head"><span>UPCOMING / PROGRAM</span><span>03 EVENTS</span></div><h3>On the move.</h3><div class="schedule-row"><time>APR 18</time><span>Kyoto</span><small>EXHIBITION</small><b>↗</b></div><div class="schedule-row"><time>MAY 02</time><span>Osaka</span><small>STUDIO SESSION</small><b>↗</b></div><div class="schedule-row"><time>JUN 12</time><span>Tokyo</span><small>OPEN HOUSE</small><b>↗</b></div></div>
        </div>}

        {s.id === 'triptych' && <div class="study-triptych-wrap"><div class="triptych-top"><span>FIELDWORK / SELECTED PROJECT</span><span>2026 — VISUAL STUDY</span></div><div class="kos-grid triptych-heading" kos-cols="12"><div kos-col-span="4"><span class="studies-kicker">PROJECT 04</span></div><div kos-col-span="8"><h3>Between the visible.</h3><p>Three moments of movement, stillness, and the space between.</p></div></div><div class="kos-grid study-triptych" kos-cols="3"><figure class="triptych-image triptych-one"><div class="triptych-figure"></div><figcaption>01 / THE FIGURE</figcaption></figure><figure class="triptych-image triptych-two"><div class="triptych-gesture"></div><figcaption>02 / THE GESTURE</figcaption></figure><figure class="triptych-image triptych-three"><div class="triptych-portrait"></div><figcaption>03 / THE PORTRAIT</figcaption></figure></div><div class="triptych-bottom"><span>ART DIRECTION / DIGITAL STUDY</span><span>VIEW SERIES ↗</span></div></div>}
        {s.id === 'essay' && <div class="study-essay-wrap"><div class="essay-masthead"><span>RESONANCE / ISSUE 01</span><span>ART, SPACE, AND MEMORY</span></div><div class="kos-grid study-essay" kos-cols="12"><div kos-col-span="8" class="essay-title"><span>01 / THE JOURNAL</span><h3>The shape of silence.</h3></div><div kos-col-span="4" class="essay-meta"><span>FIELD NOTES / 2026</span><span>AN ESSAY IN OBSERVATION</span></div><div kos-col-span="12" class="essay-landscape"><div class="essay-gateway"></div><span>WHERE LANDSCAPE BECOMES MEMORY</span></div><div kos-col-span="4" class="essay-footnote">ISSUE 01 / STUDIO JOURNAL</div><p kos-col-span="8" class="essay-body">Some places ask us to slow down. Here, image and text share a single underlying grid, giving the story room to breathe.</p></div></div>}
        {s.id === 'catalogue' && <div class="kos-grid study-catalogue" kos-cols="12"><article kos-col-span="7" class="catalogue-feature"><span>OBJECT STUDIES / 01</span><div class="catalogue-vase"></div><h3>Everyday forms.</h3><p>A collection of considered objects.</p></article><div kos-col-span="5" class="catalogue-side"><article><span>02 / MATERIAL</span><div class="catalogue-disc"></div><h4>Surface and texture</h4></article><article><span>03 / DETAIL</span><div class="catalogue-stone"></div><h4>Small observations</h4></article></div></div>}
        {s.id === 'manifesto' && <div class="kos-grid study-manifesto" kos-cols="12"><div kos-col-span="8" class="manifesto-main"><span>STUDIO / PRINCIPLES</span><h3>Make room<br/>for <em>meaning.</em></h3><p>Form follows intention. Every line, every pause, every proportion carries a decision.</p></div><aside kos-col-span="4" class="manifesto-side"><span>07 / A STATEMENT</span><div lang="ja">余白</div><p>Whitespace is not an absence. It is an active part of the composition.</p><small>DESIGN NOTES — 2026</small></aside></div>}
      </div></div>
      <div class="study-preview-controls"><label for={`preview-${s.id}`}>Preview width <output data-width-output>1100px</output></label><input id={`preview-${s.id}`} data-preview-slider type="range" min="320" max="1100" step="10" value="1100" aria-label={`Resize ${s.title} preview`} /><button type="button" data-preview-reset>Reset</button></div>
      <details class="study-source"><summary>View Kōshi structure <span>+</span></summary><pre><code>{snippets[s.id as keyof typeof snippets]}</code></pre><p>The markup above shows the structural grid. Composition-specific CSS controls the visual proportions, offsets, and responsive presentation. All examples load the project's actual <code>src/styles/koshi.css</code> through SiteLayout.</p></details>
    </section>)}
    <footer class="studies-end"><p>Structure by Kōshi. Art direction by you.</p><a href="/lab/">Explore Composition Lab ↗</a></footer>
  </div>
<script>
  document.querySelectorAll<HTMLElement>('.study-section').forEach((section) => {
    const slider = section.querySelector<HTMLInputElement>('[data-preview-slider]');
    const canvas = section.querySelector<HTMLElement>('[data-preview-canvas]');
    const output = section.querySelector<HTMLOutputElement>('[data-width-output]');
    const reset = section.querySelector<HTMLButtonElement>('[data-preview-reset]');
    if (!slider || !canvas || !output || !reset) return;
    const update = () => {
      canvas.style.setProperty('--preview-width', slider.value + 'px');
      output.value = slider.value + 'px';
      output.textContent = slider.value + 'px';
    };
    slider.addEventListener('input', update);
    reset.addEventListener('click', () => { slider.value = '1100'; update(); });
    update();
  });
</script>
</SiteLayout>
