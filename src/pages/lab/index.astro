---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CompositionLab from '../../components/CompositionLab.vue';
import '../../styles/pages/_lab.css';
---
<SiteLayout title="Composition Lab" description="Explore generated editorial layouts with Kōshi's interactive Composition Lab.">
  <div class="shell" style="padding-block: 1.5rem; border-bottom: 1px solid #d5d3cc;">
    <a href="/lab/layouts/" style="display: inline-flex; gap: 1rem; align-items: center; font-size: .875rem; text-underline-offset: .35rem;">Explore seven responsive layout studies <span aria-hidden="true">↗</span></a>
  </div>
  <CompositionLab client:load />
</SiteLayout>
